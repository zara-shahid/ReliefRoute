        lines {
          text: "  app.post(\'/api/agent/prioritize\', async (req, res) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const { siteData } = req.body;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
