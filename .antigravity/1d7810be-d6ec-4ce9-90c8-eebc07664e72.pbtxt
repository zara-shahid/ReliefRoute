    replacement_chunks {
      replacement_content: "import { DisasterSite, Vehicle, DemoReport } from \'../types\';\n\nexport const INITIAL_DEPOT_COORDS = { lat: 37.7749, lng: -122.4194 }; // Central Relief Base (HQ Depot)\n\nexport const INITIAL_SITES: DisasterSite[] = [\n  {\n    id: \'site-1\',\n    name: \'Sector 4 Community Clinic\',\n    locationName: \'1450 Mission St, San Francisco\',\n    coords: { lat: 37.7765, lng: -122.4172 },\n    resourceNeeded: \'medical\',\n    amountNeeded: 45,\n    peopleAffected: 210,\n    severity: 5,\n    reportedAt: new Date(Date.now() - 45 * 60 * 1000).toISOString(), // 45 mins ago\n    urgencyWindowHours: 2,\n    urgencyScore: 94,\n    status: \'pending\',\n    description: \'Clinic power grid offline. Critical vaccine coolers and trauma kits needed urgently.\',\n  },\n  {\n    id: \'site-2\',\n    name: \'North Bay Shelter Camp\',\n    locationName: \'Pier 27 Disaster Hub\',\n    coords: { lat: 37.8035, lng: -122.4012 },\n    resourceNeeded: \'water\',\n    amountNeeded: 120,\n    peopleAffected: 450,\n    severity: 4,\n    reportedAt: new Date(Date.now() - 90 * 60 * 1000).toISOString(), // 90 mins ago\n    urgencyWindowHours: 4,\n    urgencyScore: 82,\n    status: \'pending\',\n    description: \'Clean drinking water main severed. 450 evacuees require clean water ration packs.\',\n  },\n  {\n    id: \'site-3\',\n    name: \'East Ridge Residential Block\',\n    locationName: \'780 Potrero Ave, San Francisco\',\n    coords: { lat: 37.7612, lng: -122.4065 },\n    resourceNeeded: \'food\',\n    amountNeeded: 80,\n    peopleAffected: 180,\n    severity: 3,\n    reportedAt: new Date(Date.now() - 120 * 60 * 1000).toISOString(),\n    urgencyWindowHours: 6,\n    urgencyScore: 65,\n    status: \'pending\',\n    description: \'Elderly residents stranded without groceries after flash flooding blocked street access.\',\n  },\n  {\n    id: \'site-4\',\n    name: \'South Valley School Gym\',\n    locationName: \'2200 24th St, San Francisco\',\n    coords: { lat: 37.7523, lng: -122.4088 },\n    resourceNeeded: \'shelter\',\n    amountNeeded: 60,\n    peopleAffected: 130,\n    severity: 3,\n    reportedAt: new Date(Date.now() - 150 * 60 * 1000).toISOString(),\n    urgencyWindowHours: 8,\n    urgencyScore: 58,\n    status: \'pending\',\n    description: \'Temporary evacuation space needs emergency cots, thermal blankets, and tarps.\',\n  },\n  {\n    id: \'site-5\',\n    name: \'Sunset District Field Station\',\n    locationName: \'19th Ave & Judah St\',\n    coords: { lat: 37.7618, lng: -122.4762 },\n    resourceNeeded: \'generators\',\n    amountNeeded: 30,\n    peopleAffected: 320,\n    severity: 4,\n    reportedAt: new Date(Date.now() - 30 * 60 * 1000).toISOString(),\n    urgencyWindowHours: 3,\n    urgencyScore: 88,\n    status: \'pending\',\n    description: \'High-density apartment sub-station blackout. Mobile diesel generators required for medical oxygen units.\',\n  },\n];\n\nexport const INITIAL_VEHICLES: Vehicle[] = [\n  {\n    id: \'veh-1\',\n    name: \'Relief Transport Alpha (Heavy Truck)\',\n    type: \'heavy_truck\',\n    capacity: 250,\n    maxSpeedKmh: 45,\n    depotCoords: INITIAL_DEPOT_COORDS,\n    depotName: \'Central Logistics Hub (Civic Center)\',\n    status: \'available\',\n    driverName: \'Captain Marcus Vance\',\n  },\n  {\n    id: \'veh-2\',\n    name: \'Rapid Response Bravo (Supply Van)\',\n    type: \'rapid_van\',\n    capacity: 120,\n    maxSpeedKmh: 65,\n    depotCoords: INITIAL_DEPOT_COORDS,\n    depotName: \'Central Logistics Hub (Civic Center)\',\n    status: \'available\',\n    driverName: \'Officer Sarah Chen\',\n  },\n  {\n    id: \'veh-3\',\n    name: \'Medical Dispatch Charlie (Muni Van)\',\n    type: \'medical_heli\',\n    capacity: 80,\n    maxSpeedKmh: 80,\n    depotCoords: INITIAL_DEPOT_COORDS,\n    depotName: \'Central Logistics Hub (Civic Center)\',\n    status: \'available\',\n    driverName: \'Dr. Alex Rivera\',\n  },\n];\n\nexport const DEMO_REPORTS: DemoReport[] = [\n  {\n    id: \'demo-1\',\n    title: \'Urgent: Trauma Center Power Loss\',\n    category: \'Medical / Critical Power\',\n    urgencyBadge: \'Critical\',\n    rawText: \'URGENT MEDICAL EMERGENCY: St. Jude Trauma Annex at 2400 Geary Blvd lost main grid power 15 minutes ago. 85 patients in critical condition, including ICU ventilators. Need emergency generators and 40 trauma medical kits immediately.\',\n  },\n  {\n    id: \'demo-2\',\n    title: \'Flash Flood Evacuation Water Shortage\',\n    category: \'Water Relief\',\n    urgencyBadge: \'High\',\n    rawText: \'Flash flooding in Sector 7 near Bayview Harbor (350 Cargo Way). 300 residents evacuated to high ground. Municipal water contaminated. Requesting 150 cases of emergency drinking water and purification tablets within 3 hours.\',\n  },\n  {\n    id: \'demo-3\',\n    title: \'Senior Housing Food & Thermal Aid\',\n    category: \'Food & Supplies\',\n    urgencyBadge: \'Medium\',\n    rawText: \'Golden Gate Senior Housing block at 1200 Gough St has been without power for 6 hours. Elevator disabled, 90 elderly individuals trapped on upper floors needing ready-to-eat meal packs and 50 thermal blankets.\',\n  },\n  {\n    id: \'demo-4\',\n    title: \'Heavy Landslide Road Blockade\',\n    category: \'Rescue Gear\',\n    urgencyBadge: \'Critical\',\n    rawText: \'Landslide along Twin Peaks Drive near 500 Panorama Dr. Debris blocked access road, trapping 40 vehicles with families. Need heavy rescue gear, hydraulic cutters, and 25 emergency shelter cots.\',\n  },\n  {\n    id: \'demo-5\',\n    title: \'Water Main Burst near School Shelter\',\n    category: \'Water & Sanitation\',\n    urgencyBadge: \'High\',\n    rawText: \'Water main pipe rupture at Lincoln High School Gym shelter (2160 24th Ave). 220 refugees without drinking water or clean sanitation. Requesting 100 water crates and basic hygiene packs.\',\n  },\n];\n"
    }
